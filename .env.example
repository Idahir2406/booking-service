PORT=3000
PRODUCTION_PORT=3001
NODE_ENV=development

# Postgres (docker-compose / db service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=booking
POSTGRES_PORT=5434

# App: host Mac → localhost:3307 (puerto publicado de v4p-db). En Docker (dev.yml) → v4p-db:3306
DATABASE_URL=mysql://jefesito:loputoamo69@localhost:3307/v4pdb
DATABASE_MIGRATIONS_URL=mysql://jefesito:loputoamo69@localhost:3307/v4pdb
# MariaDB Docker de viajes4patas/web (usuario jefesito). En Docker se sobreescribe DB_HOST=v4p-db
DB_HOST=localhost
DB_DATABASE=v4pdb
DB_PORT=3307
DB_USERNAME=jefesito
DB_PASSWORD=loputoamo69
DB_PREFIX=v4p_j

STRIPE_API_KEY=sk_test_...
# Valor de `stripe listen --print-secret` o el whsec_... que muestra `stripe listen`
STRIPE_WEBHOOK_SECRET=whsec_...

FRONTEND_URL=http://localhost/viajes4patas/web
BOOKING_DEV_EMAIL=idairreyes@gmail.com
BOOKING_ADMIN_EMAIL=reservas@viajes4patas.com
BOOKING_EMAIL_LANG=es
CURRENCY=EUR

# SMTP (misma cuenta que inc/email_queue_lib.php en la web PHP)
SMTP_HOST=mail.catalunyaambgos.cat
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=reservas@catalunyaambgos.cat
SMTP_PASS=
SMTP_FROM=reservas@viajes4patas.com
SMTP_FROM_NAME=viajes4patas
SMTP_REPLY_TO=reservas@viajes4patas.com

# Redis / BullMQ (cola de emails)
REDIS_HOST=localhost
REDIS_PORT=6379
MAIL_QUEUE_NAME=mail-send
