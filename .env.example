PORT=3000
PRODUCTION_PORT=3001
NODE_ENV=development

# Postgres (docker-compose / db service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=booking
POSTGRES_PORT=5434

# App (dentro de docker el host es `db`; desde el host usa localhost:POSTGRES_PORT)
DATABASE_URL=postgresql://postgres:changeme@db:5432/booking
DATABASE_MIGRATIONS_URL=postgresql://postgres:changeme@localhost:5434/booking

DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=viajespa_v4pdb
DB_PREFIX=v4p_j

STRIPE_API_KEY=sk_test_...
# Valor de `stripe listen --print-secret` o el whsec_... que muestra `stripe listen`
STRIPE_WEBHOOK_SECRET=whsec_...

FRONTEND_URL=http://localhost/viajes4patas/web
BOOKING_DEV_EMAIL=idairreyes@gmail.com
BOOKING_ADMIN_EMAIL=reservas@viajes4patas.com
BOOKING_EMAIL_LANG=es
CURRENCY=EUR

# SMTP (misma cuenta que inc/email_queue_lib.php en la web PHP)
SMTP_HOST=mail.catalunyaambgos.cat
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=reservas@catalunyaambgos.cat
SMTP_PASS=
SMTP_FROM=reservas@viajes4patas.com
SMTP_FROM_NAME=viajes4patas
SMTP_REPLY_TO=reservas@viajes4patas.com

# Redis / BullMQ (cola de emails)
REDIS_HOST=localhost
REDIS_PORT=6379
MAIL_QUEUE_NAME=mail-send
