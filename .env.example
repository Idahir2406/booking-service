PORT=3000
PRODUCTION_PORT=3001
NODE_ENV=development

# MariaDB de viajes4patas/web. En el Mac: localhost:3307. En Docker (dev.yml) se fuerza v4p-db:3306.
DB_HOST=localhost
DB_DATABASE=v4pdb
DB_PORT=3307
DB_USERNAME=jefesito
DB_PASSWORD=loputoamo69
DB_PREFIX=v4p_j

STRIPE_API_KEY=sk_test_...
# Valor de `stripe listen --print-secret` o el whsec_... que muestra `stripe listen`
STRIPE_WEBHOOK_SECRET=whsec_...

FRONTEND_URL=http://localhost/viajes4patas/web
BOOKING_DEV_EMAIL=idairreyes@gmail.com
BOOKING_ADMIN_EMAIL=reservas@viajes4patas.com
BOOKING_EMAIL_LANG=es
CURRENCY=EUR

# SMTP (Hostinger — alinear con web/.env: SMTP_PASSWORD allí, SMTP_PASS aquí)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=reserva@viajes4patas.com
SMTP_PASS=
SMTP_FROM=reserva@viajes4patas.com
SMTP_FROM_NAME=viajes4patas
SMTP_REPLY_TO=reserva@viajes4patas.com
SMTP_HELO=viajes4patas.com

# Redis / BullMQ (cola de emails)
REDIS_HOST=localhost
REDIS_PORT=6379
MAIL_QUEUE_NAME=mail-send

# Shared secret for internal calls (PHP web -> booking), header X-Internal-Key.
# Generate with: openssl rand -hex 32 (min 32 chars)
# Payments F2: also the HMAC key of the traveler token the PHP checkout signs
# (traveler_token = PHP session user id). Must equal web BOOKING_INTERNAL_KEY.
INTERNAL_API_KEY=change-me-generate-with-openssl-rand-hex-32

# Pending reservation TTL in ms (F0 payments). Single source for the reservation
# expiration AND the Stripe Checkout Session expires_at. Stripe requires >= 30 min,
# so values below 31 min are clamped to 31 min (max 24 h). Default: 1860000 (31 min).
PENDING_RESERVATION_EXPIRATION_TIME=1860000

# Payments F1 (economic model). Commission for NEW reservations comes from the
# DB table platform_settings (commission_rate, default 0.12) and is frozen on
# each reservation. COMMISSION_PERCENTAGE is only a fallback for legacy rows
# without commission_rate (and the rate used by the F1 backfill migration).
COMMISSION_PERCENTAGE=0.1
# In-memory cache TTL (ms) for platform_settings. 0 disables the cache.
PLATFORM_SETTINGS_CACHE_TTL_MS=60000
