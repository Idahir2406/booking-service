            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"end_date\": \"2026-06-01\",\n  \"type\": \"maintenance\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/v1/blocks/{{block_id}}",
              "host": ["{{base_url}}"],
              "path": ["v1", "blocks", "{{block_id}}"]
