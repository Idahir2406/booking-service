      "item": [
        {
          "name": "List rooms by site",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/rooms/by-site/{{site_id}}",
              "host": ["{{base_url}}"],
              "path": ["v1", "rooms", "by-site", "{{site_id}}"]
            }
          },
          "response": []
        },
        {
          "name": "List public rooms by site",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  const body = json.data !== undefined ? json.data : json;",
                  "  const first = Array.isArray(body) ? body[0] : null;",
                  "  if (first && first.id) {",
                  "    pm.collectionVariables.set('room_id', first.id);",
                  "    pm.environment.set('room_id', first.id);",
                  "  }",
                  "  const boardOptions = first && Array.isArray(first.board_options) ? first.board_options : [];",
                  "  const defaultOption = boardOptions.find(s => s.is_default) || boardOptions[0];",
                  "  if (defaultOption && defaultOption.id) {",
                  "    pm.collectionVariables.set('board_option_id', defaultOption.id);",
                  "    pm.environment.set('board_option_id', defaultOption.id);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/rooms/by-site/{{site_id}}/public",
              "host": ["{{base_url}}"],
              "path": ["v1", "rooms", "by-site", "{{site_id}}", "public"]
