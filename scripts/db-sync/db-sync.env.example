# Copia este archivo a db-sync.env y ajusta solo lo que quieras sobrescribir.
# Por defecto los scripts leen el .env del proyecto:
#   LOCAL  ← POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB / POSTGRES_PORT
#   PROD   ← DATABASE_MIGRATIONS_URL (postgresql://user:pass@host:port/db)
#
# Este archivo NO se debe commitear (está en .gitignore).

# --- LOCAL (opcional; si vacío usa POSTGRES_* del .env) ---
# LOCAL_HOST=localhost
# LOCAL_PORT=5434
# LOCAL_USER=postgres
# LOCAL_PASSWORD=contraseña
# LOCAL_DB=booking

# --- PRODUCCIÓN (opcional; si vacío se parsea DATABASE_MIGRATIONS_URL) ---
# PROD_HOST=46.225.229.161
# PROD_PORT=5434
# PROD_USER=postgres
# PROD_PASSWORD=
# PROD_DB=booking

# --- Comportamiento ---
# SKIP_CONFIRM=0
# SKIP_BACKUP=0
# BACKUP_DIR=./backups
